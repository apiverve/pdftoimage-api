{
    "name": "apiverve/pdftoimage",
    "description": "PDF to Image renders the pages you choose from a PDF, uploaded or fetched from a URL, as PNG or JPG images and returns a download link for each, valid for 2 days, with its pixel size. The Free plan renders one page per call at 150 dpi; paid plans render up to 10 pages per call and can set the resolution from 72 to 300 dpi.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "pdftoimage",
        "pdf to image api",
        "pdf to png api",
        "pdf to jpg api",
        "convert pdf to image",
        "render pdf pages api"
    ],
    "homepage": "https://apiverve.com/marketplace/pdftoimage?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/pdftoimage",
        "source": "https://github.com/apiverve/pdftoimage-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Pdftoimage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Pdftoimage\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
